{
  "manifest_version": 2,
  "id": "yumemi1.jm_plugin",
  "version": "2.0.0",
  "name": "JM 本子下载插件",
  "description": "基于 jmcomic 的本子下载插件，支持章节选择、PDF 合成、以图搜本与 Napcat 上传",
  "author": {
    "name": "yumemi1",
    "url": "https://github.com/yumemi1"
  },
  "license": "MIT",
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "book-open"
    }
  },
  "urls": {
    "repository": "https://github.com/yumemi1/jm_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=0.8.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "curl_cffi",
      "version_spec": ">=0.6.0"
    },
    {
      "type": "python_package",
      "name": "olefile",
      "version_spec": ">=0.46"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    },
    {
      "type": "python_package",
      "name": "pyzipper",
      "version_spec": ">=0.3.6"
    }
  ],
  "capabilities": ["send.text", "message.get_recent", "message.get_by_id"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
